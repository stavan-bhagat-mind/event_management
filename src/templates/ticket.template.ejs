<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Event Ticket</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Poppins', sans-serif;
        background-color: #f7f7f7;
        color: #333;
        line-height: 1.6;
        padding: 20px;
      }

      .ticket-container {
        max-width: 500px;
        margin: 0 auto;
        background-color: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        position: relative;
        width: 100%;
      }

      .ticket-header {
        background: linear-gradient(135deg, #e4173e, #c70d2d);  
        color: white;
        padding: 30px 25px;
        text-align: center;
        position: relative;
      }

      .ticket-title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .ticket-subtitle {
        font-size: 18px;
        font-weight: 500;
        opacity: 0.9;
      }

      .status-badge {
  position: absolute;
  top: 20px;
  right: 20px;
  background-color: rgba(68, 240, 5, 0.613);
  backdrop-filter: blur(5px);
  padding: 5px 15px;
  border-radius: 50px;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  gap: 5px;
}

.checkmark-icon {
  width: 15px;
  height: 15px;
  vertical-align: middle;
}

.status-badge-container {
  position: absolute;
  top: 15px;
  right: 15px;
  z-index: 10;
}

.status-badge-icon {
  width: 40px;
  height: 40px;
  filter: drop-shadow(0px 2px 3px rgba(0, 0, 0, 0.2));
}

.status-badge {
  background-color: rgba(68, 240, 5, 0.613);
  backdrop-filter: blur(5px);
  padding: 5px 15px;
  border-radius: 50px;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 1px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: white;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
}
      .ticket-content {
        padding: 30px 25px;
      }

      .event-image {
        width: 100%;
        height: 160px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 20px;
      }

      .ticket-section {
        margin-bottom: 25px;
        position: relative;
      }

      .ticket-section:last-child {
        margin-bottom: 0;
      }

      .section-title {
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #d32f2f;
        font-weight: 600;
        margin-bottom: 8px;
      }

      .section-content {
        font-size: 16px;
      }

      .event-name {
        font-size: 22px;
        font-weight: 600;
        color: #333;
        line-height: 1.3;
      }

      .event-meta {
        display: flex;
        margin-top: 12px;
        gap: 15px;
        flex-wrap: wrap;
      }

      .event-meta-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 15px;
      }

      .event-meta-icon {
        min-width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .icon {
        width: 18px;
        height: 18px;
        fill: #d32f2f;
      }

      .ticket-info {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        margin-top: 10px;
        background-color: #f9f9f9;
        border-radius: 8px;
        padding: 15px;
        gap: 10px;
      }

      .ticket-info-column {
        flex: 1;
        min-width: 150px;
      }

      .ticket-info-columnn {
        flex: 1;
        min-width: 150px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .ticket-info-label {
        font-size: 12px;
        color: #777;
      }

      .ticket-info-value {
        font-weight: 600;
        font-size: 15px;
        word-break: break-word;
      }

      .divider {
        height: 1px;
        background-color: #eee;
        margin: 25px 0;
        position: relative;
      }

      .divider::before,
      .divider::after {
        content: '';
        position: absolute;
        width: 20px;
        height: 20px;
        background-color: #f7f7f7;
        border-radius: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
      }

      .divider::before {
        left: -10px;
      }

      .divider::after {
        right: -30px;
      }

      .user-info {
        display: flex;
        align-items: center;
        gap: 15px;
      }
      .user-avatar {
        width: 40px;
        height: 40px;
        overflow: hidden;
        border-radius: 10%;
        border: 1px solid #ccc;
      }

      .avatar {
        width: 100%;
        height: 100%;
        /* height: auto; */
        object-fit: cover;
        filter: grayscale(60%);
      }
      .avatar-initials {
        width: 40px;
        height: 40px;
        border-radius: 10%;
        background-color: #f2f2f2;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        font-weight: 600;
        color: #d32f2f;
      }
      .user-details {
        flex: 1;
        min-width: 0;
      }

      .user-name {
        font-weight: 600;
        font-size: 16px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .user-contact {
        font-size: 14px;
        color: #666;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .footer {
        margin-top: 10px;
        text-align: center;
        font-size: 12px;
        color: #888;
      }

      .price-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: #f9f9f9;
        padding: 12px 15px;
        border-radius: 8px;
        margin-top: 12px;
        flex-wrap: wrap;
        gap: 10px;
      }

      .price-item {
        text-align: center;
        flex: 1;
        min-width: 80px;
      }

      .price-label {
        font-size: 12px;
        color: #777;
      }

      .price-value {
        font-weight: 600;
        font-size: 16px;
      }

      .total-price {
        font-size: 18px;
        font-weight: 700;
        color: #d32f2f;
      }

      @media (max-width: 480px) {
        body {
          padding: 10px;
        }

        .ticket-header {
          padding: 20px 15px;
        }

        .status-badge {
          top: 10px;
          right: 10px;
          padding: 4px 10px;
          font-size: 7px;
        }

        .ticket-title {
          font-size: 20px;
        }

        .ticket-subtitle {
          font-size: 16px;
        }

        .ticket-content {
          padding: 20px 15px;
        }

        .event-name {
          font-size: 18px;
        }

        .event-meta {
          flex-direction: column;
          gap: 8px;
        }

        .price-section {
          flex-direction: column;
          align-items: flex-start;
          padding: 10px;
        }

        .price-item {
          display: flex;
          width: 100%;
          justify-content: space-between;
          text-align: left;
          padding: 5px 0;
          
        }

        .ticket-info {
          flex-direction: column;
        }

        .ticket-info-column,
        .ticket-info-columnn {
          width: 100%;
          margin-bottom: 10px;
        }

        .ticket-info-columnn {
          gap: 15px;
        }
      }

      @media (max-width: 360px) {
        .ticket-title {
          font-size: 18px;
        }

        .ticket-subtitle {
          font-size: 14px;
        }

        .event-name {
          font-size: 16px;
        }

        .section-title {
          font-size: 12px;
        }

        .user-name,
        .price-value,
        .ticket-info-value {
          font-size: 14px;
        }

        .user-contact,
        .event-meta-item,
        .price-label,
        .ticket-info-label {
          font-size: 12px;
        }
      }
    </style>
  </head>
  <body>
    <div class="ticket-container">
      <div class="ticket-header">
        <!-- <div class="status-badge"><%= booking.status&&'✓'%></div> -->
        <div class="status-badge-container">
            <% if (booking.status === 'CONFIRMED') { %>
              <svg class="status-badge-icon" width="40" height="40" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <!-- Organic blob shape -->
                <path d="M50 10 C70 0, 90 20, 95 40 C100 60, 90 80, 70 90 C60 95, 40 95, 30 90 C10 80, 0 60, 5 40 C10 20, 30 0, 50 10 Z" fill="rgba(68, 240, 5, 0.8)"/>
                <!-- Checkmark -->
                <path d="M30 50 L45 65 L70 35" stroke="white" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            <% } else { %>
              <div class="status-badge"><%= booking.status || '✔' %></div>
            <% } %>
          </div>
        <h1 class="ticket-title">Event Ticket</h1>
        <p class="ticket-subtitle">
          Booking #<%= booking._id.toString().slice(-8).toUpperCase() %>
        </p>
      </div>

      <div class="ticket-content">
        <div class="ticket-section">
          <div class="section-title">Event</div>
          <div class="event-name"><%= event.title %></div>

          <div class="event-meta">
            <div class="event-meta-item">
              <div class="event-meta-icon">
                <svg
                  class="icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M19,4H17V3a1,1,0,0,0-2,0V4H9V3A1,1,0,0,0,7,3V4H5A3,3,0,0,0,2,7V19a3,3,0,0,0,3,3H19a3,3,0,0,0,3-3V7A3,3,0,0,0,19,4Zm1,15a1,1,0,0,1-1,1H5a1,1,0,0,1-1-1V12H20Zm0-9H4V7A1,1,0,0,1,5,6H7V7A1,1,0,0,0,9,7V6h6V7a1,1,0,0,0,2,0V6h2a1,1,0,0,1,1,1Z"
                  />
                </svg>
              </div>
              <span><%= event.date %></span>
            </div>

            <div class="event-meta-item">
              <div class="event-meta-icon">
                <svg
                  class="icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M12,2A10,10,0,1,0,22,12,10,10,0,0,0,12,2Zm0,18a8,8,0,1,1,8-8A8,8,0,0,1,12,20ZM16,9H13V6a1,1,0,0,0-2,0V9a2,2,0,0,0,2,2h3a1,1,0,0,0,0-2Z"
                  />
                </svg>
              </div>
              <span><%= event.startTime %></span>
            </div>

            <div class="event-meta-item">
              <div class="event-meta-icon">
                <svg
                  class="icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M12,2a8,8,0,0,0-8,8c0,5.4,7.05,11.5,7.35,11.76a1,1,0,0,0,1.3,0C13,21.5,20,15.4,20,10A8,8,0,0,0,12,2Zm0,17.65c-2.13-2-6-6.31-6-9.65a6,6,0,0,1,12,0C18,13.34,14.13,17.66,12,19.65ZM12,6a4,4,0,1,0,4,4A4,4,0,0,0,12,6Zm0,6a2,2,0,1,1,2-2A2,2,0,0,1,12,12Z"
                  />
                </svg>
              </div>
              <span><%= event.location %></span>
            </div>
          </div>

          <div class="price-section">
            <div class="price-item">
              <div class="price-label">Price per ticket</div>
              <div class="price-value">
                <%= event.price %> <span style="font-size: medium">₹</span>
              </div>
            </div>
            <div class="price-item">
              <div class="price-label">Tickets</div>
              <div class="price-value"><%= booking.seatsBooked %></div>
            </div>
            <div class="price-item">
              <div class="price-label">Total</div>
              <div class="price-value total-price">
                <%= booking.totalPrice %> ₹
              </div>
            </div>
          </div>
        </div>

        <div class="divider"></div>

        <div class="ticket-section">
          <div class="section-title">Attendee</div>
          <div class="user-info">
            <div class="user-avatar">
                <% if (userProfile) { %>
                    <img src="<%= userProfile %>" alt="User  Avatar" class="avatar" />
                <% } else { %>
                    <div class="avatar-initials">
                            <%= user.firstName.charAt(0).toUpperCase() %><%= user.lastName.charAt(0).toUpperCase() %>
                    </div>
                <% } %>
            </div>
   
            <div class="user-details">
              <div class="user-name">
                <%= user.firstName %> <%= user.lastName %>
              </div>
              <div class="user-contact"><%= user.contactNumber %></div>
            </div>
          </div>
        </div>

        <div class="divider"></div>

        <div class="ticket-section">
          <div class="section-title">Payment Information</div>
          <div class="ticket-info">
            <div class="ticket-info-column">
              <div class="ticket-info-label">Transaction ID</div>
              <div class="ticket-info-value">
                <%= booking.payment.transactionId %>
              </div>
            </div>

            <div class="ticket-info-columnn">
              <div>
                <div class="ticket-info-label">Payment Date</div>
                <div class="ticket-info-value">
                  <%= new Date(booking.payment.updatedAt).toLocaleDateString()
                  %>
                </div>
              </div>

              <div>
                <div class="ticket-info-label">Status</div>
                <div class="ticket-info-value">
                  <%= booking.payment.status %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="footer">
      This ticket was verified on <%= new Date().toLocaleString() %>
    </div>
  </body>
</html>
