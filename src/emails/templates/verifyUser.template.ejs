<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Email Verification</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 600px;
        margin: 20px auto;
        margin-bottom: 0%;
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
      }
      .header {
        text-align: center;
        padding: 20px;
        padding-bottom: 0%;
        background-color: #ffffff;
      }
      .header img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
      }
      .content {
        padding: 20px;
        padding-top: 0%;
        text-align: center;
      }
      .content h1 {
        font-size: 24px;
        color: #333333;
        margin-top: 0%;
        margin-bottom: 20px;
      }
      .content p {
        color: #555555;
        font-size: 14px;
        line-height: 1.6;
        margin: 0 0 20px;
      }
      .button {
        display: inline-block;
        padding: 12px 24px;
        background-color: #7db9f9;
        color: #ffffff;
        text-decoration: none;
        border-radius: 4px;
        margin: 0 0 20px;
        font-size: 16px;
        font-weight: 600;
        transition: background-color 0.3s ease;
      }
      .button:hover {
        background-color: #5a9de6;
      }
      .footer {
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 0 0 8px 8px;
        text-align: center;
      }
      .footer p {
        color: #718096;
        font-size: 12px;
        line-height: 1.5;
        margin: 0 0 10px;
      }
      .footer a {
        color: #4299e1;
        text-decoration: none;
      }
      .footer a:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- Header with Image -->
      <div class="header">
        <img src="<%= imageUrl %>" alt="Header Image" />
      </div>

      <!-- Content -->
      <div class="content">
        <h1>Verify Your Email Address</h1>
        <p>
          You've entered <strong><%= email %></strong> as the email address for
          your account.
        </p>
        <p>Please verify this email address by clicking the button below:</p>
        <a href="<%= verificationUrl %>" class="button">Verify Email</a>
        <p>
          If you did not create an account, you can safely ignore this email.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>
          Need help? <a href="<%= supportUrl %>">Contact our support team</a>
        </p>
        <p>
          &copy; <%= new Date().getFullYear() %> <%= appName %>. All rights
          reserved.
        </p>
      </div>
    </div>
  </body>
</html>
